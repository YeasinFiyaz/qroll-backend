# Copy to .env (local) or add these in your host's Environment Variables page.

# MySQL database
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# true for cloud MySQL that requires TLS (Aiven, TiDB Cloud, PlanetScale, ...)
DB_SSL=false

# Long random string used to sign login tokens
JWT_SECRET=
# How long a login lasts
JWT_EXPIRES_IN=7d

# Frontend address(es), comma separated. Used for CORS and QR links.
FRONTEND_URL=https://qroll-frontend-eta.vercel.app

# Gmail address + App Password for low-attendance alert emails (optional)
EMAIL_USER=
EMAIL_PASS=

# Attendance % below which a student counts as "low"
LOW_ATTENDANCE_THRESHOLD=75

# Only used when running as a normal server (Render / local)
PORT=5000
